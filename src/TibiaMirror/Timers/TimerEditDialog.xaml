<Window x:Class="TibiaMirror.Timers.TimerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TibiaMirror.Controls"
        xmlns:loc="clr-namespace:TibiaMirror.Localization"
        Title="{loc:Loc Timers_DialogTitle}" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindowStyle}">
    <StackPanel Margin="12">
        <TextBlock Text="{loc:Loc Timers_Name}"/>
        <TextBox x:Name="NameBox" MaxLength="40" Margin="0,2,0,8"/>
        <TextBlock Text="{loc:Loc Timers_HotkeyLabel}"/>
        <controls:HotkeyBox x:Name="KeyBox" HorizontalAlignment="Left" Margin="0,2,0,8"/>
        <TextBlock Text="{loc:Loc Timers_DurationLabel}"/>
        <TextBox x:Name="DurationBox" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="RepeatCheck" Content="{loc:Loc Timers_RepeatEvery}" VerticalAlignment="Center"/>
            <TextBox x:Name="IntervalBox" Width="70" Margin="6,0,6,0" IsEnabled="{Binding IsChecked, ElementName=RepeatCheck}"/>
            <TextBlock Text="{loc:Loc Timers_SecondsUnit}" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{loc:Loc Timers_Sound}"/>
        <DockPanel Margin="0,2,0,8">
            <Button x:Name="TestButton" DockPanel.Dock="Right" Content="{loc:Loc Timers_Test}" Padding="10,2" Margin="6,0,0,0" Click="Test_Click"/>
            <ComboBox x:Name="SoundBox" DisplayMemberPath="Name" SelectionChanged="SoundBox_SelectionChanged"/>
        </DockPanel>
        <StackPanel x:Name="SoundWarningPanel" Orientation="Horizontal" Margin="0,-4,0,8" Visibility="Collapsed">
            <TextBlock Style="{StaticResource Glyph}" Text="{StaticResource Glyph.Warning}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="SoundWarning" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Text="{loc:Loc Timers_Volume}"/>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="0,2,0,8" IsSnapToTickEnabled="True" TickFrequency="1"/>
        <TextBlock Text="{loc:Loc Timers_OnRepress}"/>
        <StackPanel Margin="0,2,0,8">
            <RadioButton x:Name="RestartRadio" Content="{loc:Loc Timers_RestartTimer}" IsChecked="True"/>
            <RadioButton x:Name="IgnoreRadio" Content="{loc:Loc Timers_IgnoreWhileRunning}"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Button.Primary}" Content="{loc:Loc Timers_Save}" IsDefault="True" Width="80" Margin="0,0,6,0" Click="Save_Click"/>
            <Button Content="{loc:Loc Common_Cancel}" IsCancel="True" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
