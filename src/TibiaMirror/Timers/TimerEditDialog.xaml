<Window x:Class="TibiaMirror.Timers.TimerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TibiaMirror.Controls"
        Title="Audio timer" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="Name"/>
        <TextBox x:Name="NameBox" MaxLength="40" Margin="0,2,0,8"/>
        <TextBlock Text="Hotkey (pressed while Tibia is focused)"/>
        <controls:HotkeyBox x:Name="KeyBox" HorizontalAlignment="Left" Margin="0,2,0,8"/>
        <TextBlock Text="Duration (seconds)"/>
        <TextBox x:Name="DurationBox" Margin="0,2,0,8"/>
        <TextBlock Text="Sound"/>
        <DockPanel Margin="0,2,0,8">
            <Button x:Name="TestButton" DockPanel.Dock="Right" Content="Test" Padding="10,2" Margin="6,0,0,0" Click="Test_Click"/>
            <ComboBox x:Name="SoundBox" DisplayMemberPath="Name" SelectionChanged="SoundBox_SelectionChanged"/>
        </DockPanel>
        <TextBlock Text="Volume"/>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Margin="0,2,0,8" IsSnapToTickEnabled="True" TickFrequency="1"/>
        <TextBlock Text="When the key is pressed again while running"/>
        <StackPanel Margin="0,2,0,8">
            <RadioButton x:Name="RestartRadio" Content="Restart the timer" IsChecked="True"/>
            <RadioButton x:Name="IgnoreRadio" Content="Ignore while running"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" Width="80" Margin="0,0,6,0" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True" Width="80"/>
        </StackPanel>
    </StackPanel>
</Window>
