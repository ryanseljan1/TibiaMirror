<Window x:Class="TibiaMirror.Mirrors.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TibiaMirror.Localization"
        Title="{loc:Loc Mirrors_RenameTitle}" Width="300" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindowStyle}">
    <StackPanel Margin="12">
        <TextBox x:Name="NameBox" MaxLength="40" TextChanged="NameBox_TextChanged"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" Text="{loc:Loc Mirrors_NameError}" Margin="0,4,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Style="{StaticResource Button.Primary}" Content="{loc:Loc Common_Ok}" Width="70" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{loc:Loc Common_Cancel}" Width="70" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
