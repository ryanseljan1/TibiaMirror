<Window x:Class="TibiaMirror.Mirrors.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Width="300" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBox x:Name="NameBox" MaxLength="40" TextChanged="NameBox_TextChanged"/>
        <TextBlock x:Name="ErrorText" Foreground="Firebrick" Text="Name must be 1-40 characters." Margin="0,4,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="70" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="70" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
