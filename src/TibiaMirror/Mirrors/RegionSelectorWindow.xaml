<Window x:Class="TibiaMirror.Mirrors.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:TibiaMirror.Localization"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" Cursor="Cross">
    <!-- Overlay sits on top of the game: fixed colours (not theme tokens) so it reads on any scene. -->
    <Canvas x:Name="Overlay" Background="Transparent">
        <Path x:Name="Dim" Fill="#66000000" IsHitTestVisible="False"/>
        <Rectangle x:Name="Outline" Stroke="#FFFF7F00" StrokeThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
        <TextBlock x:Name="SizeLabel" Foreground="White" Background="#CC000000" Padding="4,1" Visibility="Collapsed" IsHitTestVisible="False"/>
        <TextBlock Text="{loc:Loc Mirrors_SelectHint}" Foreground="White" Background="#CC000000"
                   Padding="6,3" Canvas.Left="8" Canvas.Top="8" IsHitTestVisible="False"/>
    </Canvas>
</Window>
