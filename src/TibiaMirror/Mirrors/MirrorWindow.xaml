<Window x:Class="TibiaMirror.Mirrors.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False" Background="Black"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Grid>
        <!-- glow border: 1px layers fading inwards, drawn in the window edge the thumbnail is inset by -->
        <Grid x:Name="GlowLayers" IsHitTestVisible="False"/>
        <Border x:Name="Frame">
            <TextBlock x:Name="Placeholder" Text="Can't mirror &#x2014; is Tibia minimized?" Foreground="White"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="4" FontSize="11" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Border>
        <Grid x:Name="Handles">
            <Rectangle x:Name="HandleTL" Width="12" Height="12" Fill="#01000000" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
            <Rectangle x:Name="HandleTR" Width="12" Height="12" Fill="#01000000" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
            <Rectangle x:Name="HandleBL" Width="12" Height="12" Fill="#01000000" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
            <Rectangle x:Name="HandleBR" Width="12" Height="12" Fill="#01000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
        </Grid>
    </Grid>
</Window>
