<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="ThemeId">Light</sys:String>

    <Color x:Key="Color.Window">#F6F7F9</Color>
    <Color x:Key="Color.Sidebar">#EDEFF3</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceRaised">#FFFFFF</Color>
    <Color x:Key="Color.Inset">#EEF0F4</Color>
    <Color x:Key="Color.BorderSubtle">#E1E4EA</Color>
    <Color x:Key="Color.BorderControl">#7A8293</Color>
    <Color x:Key="Color.Text">#161A21</Color>
    <Color x:Key="Color.TextSecondary">#4B5363</Color>
    <Color x:Key="Color.TextMuted">#5F6778</Color>
    <Color x:Key="Color.TextDisabled">#9AA2B1</Color>
    <Color x:Key="Color.AccentText">#9A4D00</Color>
    <Color x:Key="Color.AccentSubtle">#1FFF7F00</Color>
    <Color x:Key="Color.Focus">#9A4D00</Color>
    <Color x:Key="Color.Success">#1E7F4F</Color>
    <Color x:Key="Color.Warning">#8A5A00</Color>
    <Color x:Key="Color.Danger">#C62828</Color>
    <Color x:Key="Color.Info">#1D5FBF</Color>
    <Color x:Key="Color.StateLayer">#000000</Color>
    <Color x:Key="Color.Scrim">#66101828</Color>

    <SolidColorBrush x:Key="Brush.Window"        Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.Sidebar"       Color="{StaticResource Color.Sidebar}"/>
    <SolidColorBrush x:Key="Brush.Surface"       Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Brush.Inset"         Color="{StaticResource Color.Inset}"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle"  Color="{StaticResource Color.BorderSubtle}"/>
    <SolidColorBrush x:Key="Brush.BorderControl" Color="{StaticResource Color.BorderControl}"/>
    <SolidColorBrush x:Key="Brush.Text"          Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled"  Color="{StaticResource Color.TextDisabled}"/>
    <SolidColorBrush x:Key="Brush.Accent"        Color="#FF7F00"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="#FF9A2E"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#E06F00"/>
    <SolidColorBrush x:Key="Brush.OnAccent"      Color="#1A0F00"/>
    <SolidColorBrush x:Key="Brush.AccentText"    Color="{StaticResource Color.AccentText}"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle"  Color="{StaticResource Color.AccentSubtle}"/>
    <SolidColorBrush x:Key="Brush.Focus"         Color="{StaticResource Color.Focus}"/>
    <SolidColorBrush x:Key="Brush.Success"       Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.OnSuccess"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Warning"       Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger"        Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.OnDanger"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Info"          Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.StateLayer"    Color="{StaticResource Color.StateLayer}"/>
    <SolidColorBrush x:Key="Brush.Scrim"         Color="{StaticResource Color.Scrim}"/>
    <!-- Subtle semantic fills (16% dark / 12% light) -->
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#1F1E7F4F"/>
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#1F8A5A00"/>
    <SolidColorBrush x:Key="Brush.DangerSubtle"  Color="#1FC62828"/>
    <SolidColorBrush x:Key="Brush.InfoSubtle"    Color="#1F1D5FBF"/>
    <!-- Card sheen (reflection motif) -->
    <LinearGradientBrush x:Key="Brush.CardSheen" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Elevation.2" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
    <DropShadowEffect x:Key="Elevation.3" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.18" Color="#000000"/>
</ResourceDictionary>
