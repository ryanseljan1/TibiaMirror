<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="ThemeId">HighContrast</sys:String>

    <x:Static x:Key="Color.Window" Member="SystemColors.WindowColor"/>
    <x:Static x:Key="Color.Sidebar" Member="SystemColors.WindowColor"/>
    <x:Static x:Key="Color.Surface" Member="SystemColors.WindowColor"/>
    <x:Static x:Key="Color.SurfaceRaised" Member="SystemColors.ControlColor"/>
    <x:Static x:Key="Color.Inset" Member="SystemColors.WindowColor"/>
    <x:Static x:Key="Color.BorderSubtle" Member="SystemColors.GrayTextColor"/>
    <x:Static x:Key="Color.BorderControl" Member="SystemColors.WindowTextColor"/>
    <x:Static x:Key="Color.Text" Member="SystemColors.WindowTextColor"/>
    <x:Static x:Key="Color.TextSecondary" Member="SystemColors.WindowTextColor"/>
    <x:Static x:Key="Color.TextMuted" Member="SystemColors.WindowTextColor"/>
    <x:Static x:Key="Color.TextDisabled" Member="SystemColors.GrayTextColor"/>
    <x:Static x:Key="Color.AccentText" Member="SystemColors.HighlightColor"/>
    <Color x:Key="Color.AccentSubtle">#00000000</Color>
    <x:Static x:Key="Color.Focus" Member="SystemColors.HighlightColor"/>
    <x:Static x:Key="Color.Success" Member="SystemColors.WindowTextColor"/>
    <x:Static x:Key="Color.Warning" Member="SystemColors.WindowTextColor"/>
    <x:Static x:Key="Color.Danger" Member="SystemColors.WindowTextColor"/>
    <x:Static x:Key="Color.Info" Member="SystemColors.HotTrackColor"/>
    <x:Static x:Key="Color.StateLayer" Member="SystemColors.WindowTextColor"/>
    <Color x:Key="Color.Scrim">#99000000</Color>

    <SolidColorBrush x:Key="Brush.Window"        Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.Sidebar"       Color="{StaticResource Color.Sidebar}"/>
    <SolidColorBrush x:Key="Brush.Surface"       Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}"/>
    <SolidColorBrush x:Key="Brush.Inset"         Color="{StaticResource Color.Inset}"/>
    <SolidColorBrush x:Key="Brush.BorderSubtle"  Color="{StaticResource Color.BorderSubtle}"/>
    <SolidColorBrush x:Key="Brush.BorderControl" Color="{StaticResource Color.BorderControl}"/>
    <SolidColorBrush x:Key="Brush.Text"          Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextMuted"     Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled"  Color="{StaticResource Color.TextDisabled}"/>
    <SolidColorBrush x:Key="Brush.Accent"        Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Brush.AccentHover"   Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="Brush.OnAccent"      Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="Brush.AccentText"    Color="{StaticResource Color.AccentText}"/>
    <SolidColorBrush x:Key="Brush.AccentSubtle"  Color="{StaticResource Color.AccentSubtle}"/>
    <SolidColorBrush x:Key="Brush.Focus"         Color="{StaticResource Color.Focus}"/>
    <SolidColorBrush x:Key="Brush.Success"       Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning"       Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Danger"        Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.OnDanger"      Color="{x:Static SystemColors.WindowColor}"/>
    <SolidColorBrush x:Key="Brush.Info"          Color="{StaticResource Color.Info}"/>
    <SolidColorBrush x:Key="Brush.StateLayer"    Color="{StaticResource Color.StateLayer}"/>
    <SolidColorBrush x:Key="Brush.Scrim"         Color="{StaticResource Color.Scrim}"/>
    <!-- Subtle semantic fills (16% dark / 12% light) -->
    <SolidColorBrush x:Key="Brush.SuccessSubtle" Color="#293DD68C"/>
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="#29F5B73B"/>
    <SolidColorBrush x:Key="Brush.DangerSubtle"  Color="#29FF6B6B"/>
    <SolidColorBrush x:Key="Brush.InfoSubtle"    Color="#295CA8FF"/>
    <!-- Card sheen (reflection motif) -->
    <LinearGradientBrush x:Key="Brush.CardSheen" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0FFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <DropShadowEffect x:Key="Elevation.2" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/>
    <DropShadowEffect x:Key="Elevation.3" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000"/>
    <!-- Legacy aliases -->
    <SolidColorBrush x:Key="ThemeWindowBrush" Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="ThemeTextBrush" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="ThemeControlBrush" Color="{StaticResource Color.Inset}"/>
    <SolidColorBrush x:Key="ThemeMutedBrush" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="ThemeBorderBrush" Color="{StaticResource Color.BorderControl}"/>
    <SolidColorBrush x:Key="ThemeErrorBrush" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="ThemeSelectionBrush" Color="{StaticResource Color.AccentSubtle}"/>
    <SolidColorBrush x:Key="ThemeTabBrush" Color="{StaticResource Color.Sidebar}"/>
    <SolidColorBrush x:Key="ThemeBannerBrush" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="ThemeBannerTextBrush" Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="ThemeCheckedBrush" Color="{x:Static SystemColors.HighlightColor}"/>
    <SolidColorBrush x:Key="ThemeCheckedTextBrush" Color="{x:Static SystemColors.HighlightTextColor}"/>
    <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="ThemeOnSuccessBrush" Color="{StaticResource Color.Window}"/>
</ResourceDictionary>
