<Window x:Class="TibiaMirror.Profiles.Toast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        SizeToContent="WidthAndHeight">
    <Border Background="#E6202020" CornerRadius="6" Padding="16,8">
        <TextBlock x:Name="Label" Foreground="White" FontSize="16"/>
    </Border>
</Window>
