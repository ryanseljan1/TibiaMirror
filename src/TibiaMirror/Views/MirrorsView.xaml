<UserControl x:Class="TibiaMirror.Views.MirrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel Margin="8">
        <Button DockPanel.Dock="Top" Content="&#xFF0B; Add Region" Command="{Binding AddRegionCommand}"
                HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8"/>
        <Grid>
            <TextBlock Text="No mirrors yet. Start Tibia and click Add Region." HorizontalAlignment="Center"
                       VerticalAlignment="Top" Margin="0,24,0,0" Foreground="{DynamicResource ThemeMutedBrush}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <ToggleButton DockPanel.Dock="Right" Content="&#x1F512;" ToolTip="Lock" Width="30" Margin="4,0,0,0"
                                                      IsChecked="{Binding IsLocked, Mode=TwoWay}"/>
                                        <ToggleButton DockPanel.Dock="Right" Content="&#x1F441;" ToolTip="Visible" Width="30" Margin="4,0,0,0"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                                        <Button DockPanel.Dock="Right" Content="&#x270F;" ToolTip="Rename" Width="30" Margin="4,0,0,0"
                                                Command="{Binding RenameCommand}"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   MouseLeftButtonDown="Name_MouseLeftButtonDown"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding OpacityText}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Left" Text="Opacity" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <Slider Minimum="0.1" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Re-crop" Padding="10,2" Command="{Binding RecropCommand}"/>
                                        <Button Content="Delete" Padding="10,2" Margin="6,0,0,0" Command="{Binding DeleteCommand}"/>
                                    </StackPanel>
                                    <Expander Header="Countdown" Margin="0,6,0,0">
                                        <ContentPresenter Content="{Binding CountdownEditor}"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
