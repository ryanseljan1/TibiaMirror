<UserControl x:Class="TibiaMirror.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:TibiaMirror.Localization">
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="{loc:Loc Profiles_New}" Click="New_Click" Style="{StaticResource Button.Primary}" Margin="0,0,4,4"/>
            <Button Content="{loc:Loc Profiles_Duplicate}" Click="Duplicate_Click" Margin="0,0,4,4"/>
            <Button Content="{loc:Loc Profiles_Rename}" Click="Rename_Click" Margin="0,0,4,4"/>
            <Button Content="{loc:Loc Profiles_Delete}" Click="Delete_Click" Style="{StaticResource Button.Danger}" Margin="0,0,4,4"/>
            <Button Content="{loc:Loc Profiles_Switch}" Click="Switch_Click" Margin="0,0,4,4"/>
            <Button Content="{loc:Loc Profiles_Import}" Click="Import_Click" Margin="0,0,4,4"/>
            <Button Content="{loc:Loc Profiles_Export}" Click="Export_Click" Margin="0,0,4,4"/>
        </WrapPanel>
        <ListBox x:Name="List" MouseDoubleClick="List_DoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Tick" Style="{StaticResource Glyph}" Text="{StaticResource Glyph.Check}" Margin="0,0,6,0" Visibility="Collapsed"/>
                        <TextBlock Text="{Binding Display}"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
