<UserControl x:Class="TibiaMirror.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="New" Click="New_Click" Padding="8,2" Margin="0,0,4,4"/>
            <Button Content="Duplicate" Click="Duplicate_Click" Padding="8,2" Margin="0,0,4,4"/>
            <Button Content="Rename" Click="Rename_Click" Padding="8,2" Margin="0,0,4,4"/>
            <Button Content="Delete" Click="Delete_Click" Padding="8,2" Margin="0,0,4,4"/>
            <Button Content="Switch" Click="Switch_Click" Padding="8,2" Margin="0,0,4,4"/>
            <Button Content="Import..." Click="Import_Click" Padding="8,2" Margin="0,0,4,4"/>
            <Button Content="Export..." Click="Export_Click" Padding="8,2" Margin="0,0,4,4"/>
        </WrapPanel>
        <ListBox x:Name="List" DisplayMemberPath="Display" MouseDoubleClick="List_DoubleClick"/>
    </DockPanel>
</UserControl>
