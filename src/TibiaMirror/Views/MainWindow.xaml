<Window x:Class="TibiaMirror.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TibiaMirror.Views"
        xmlns:controls="clr-namespace:TibiaMirror.Controls"
        Title="TibiaMirror" Width="520" Height="640" MinWidth="420" Style="{StaticResource AppWindowStyle}">
    <DockPanel>
        <Border x:Name="HotkeyBanner" DockPanel.Dock="Top" Background="{DynamicResource ThemeBannerBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="RetryHotkeysButton" DockPanel.Dock="Right" Content="Retry" Padding="8,1"/>
                <TextBlock Text="Hotkeys are unavailable." VerticalAlignment="Center" Foreground="{DynamicResource ThemeBannerTextBrush}"/>
            </DockPanel>
        </Border>
        <!-- InfoBarHost: contract for the updater UI (B4 sets Content from App.xaml.cs). Keep name + public modifier. -->
        <ContentControl x:Name="InfoBarHost" x:FieldModifier="public" DockPanel.Dock="Top"/>
        <DockPanel DockPanel.Dock="Top" Margin="8">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="⚙" Width="32" Margin="4,0,0,0"/>
            <Button x:Name="LockAllButton" DockPanel.Dock="Right" Content="Lock all" Padding="8,2" Margin="4,0,0,0"/>
            <Button x:Name="ShowHideAllButton" DockPanel.Dock="Right" Content="Show/Hide all" Padding="8,2" Margin="4,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" x:Name="StatusPanel">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" StrokeThickness="1" Stroke="{DynamicResource ThemeMutedBrush}" Fill="#FF9AA3AE"/>
                    <TextBlock x:Name="StatusText" Text="Waiting for Tibia…" AutomationProperties.Name="Waiting for Tibia…"/>
                </StackPanel>
                <TextBlock x:Name="ProfileText"/>
            </StackPanel>
        </DockPanel>
        <Grid>
            <TabControl>
                <TabItem Header="Mirrors"><views:MirrorsView x:Name="MirrorsPage"/></TabItem>
                <TabItem Header="Audio Timers"><views:AudioTimersView x:Name="TimersView"/></TabItem>
                <TabItem Header="Profiles"><views:ProfilesView x:Name="ProfilesTab"/></TabItem>
            </TabControl>
            <controls:Snackbar x:Name="SnackbarHost" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,16"/>
        </Grid>
    </DockPanel>
</Window>
